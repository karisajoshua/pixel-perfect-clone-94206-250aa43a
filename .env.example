# DMVIC Motor UAT — server-side only
# Populate these in your deployment secret manager. Never commit real values.
DMVIC_UAT_BASE_URL=https://uat-api.dmvic.com
DMVIC_UAT_USERNAME=
DMVIC_UAT_PASSWORD=
DMVIC_UAT_CLIENT_ID=

# Base64-encoded PKCS#12/PFX bytes, NOT a file path.
DMVIC_UAT_CLIENT_CERT=
DMVIC_UAT_CLIENT_CERT_PASSWORD=
